# GEMINI_API_KEY: Optional Google Gemini API key.
# If both providers are configured, Gemini is tried first and Groq is used
# automatically when the Gemini request fails.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Optional Groq API key.
# Create one at https://console.groq.com/keys
GROQ_API_KEY="MY_GROQ_API_KEY"

# GROQ_MODEL: Groq model identifier.
GROQ_MODEL="llama-3.3-70b-versatile"

# AI_PROVIDER: Optional provider preference: auto, gemini, or groq.
# Use "groq" when Gemini is unavailable or its key is not working.
AI_PROVIDER="auto"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
