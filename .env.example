# GEMINI_API_KEY: Optional Google Gemini API key.
# If both providers are configured, Gemini is tried first and Groq is used
# automatically when the Gemini request fails.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Comma-separated Gemini model order. The remaining timeout is shared across models.
GEMINI_MODEL="gemini-2.5-flash,gemini-2.0-flash-lite"
GEMINI_TIMEOUT_MS="40000"

# GROQ_API_KEY: Optional Groq API key.
# Create one at https://console.groq.com/keys
GROQ_API_KEY="MY_GROQ_API_KEY"

# GROQ_MODEL: Groq model identifier.
GROQ_MODEL="openai/gpt-oss-120b"

# Set to 1 for deterministic local/test runs without any model calls.
UTSAV_AI_OFFLINE="0"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
